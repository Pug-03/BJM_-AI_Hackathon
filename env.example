# ─── ABLE environment variables ───────────────────────────────────────────────
# Copy to `.env` (read by both Next.js and the Prisma CLI): cp env.example .env
# The app never white-screens when a key is missing: related features show a
# short explanation instead.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres with pgvector). Local: `docker compose up -d db` (port 5433)
DATABASE_URL=postgresql://able:able@localhost:5433/able
# Direct (non-pooled) URL used by Prisma migrations. Same as DATABASE_URL locally.
DIRECT_URL=postgresql://able:able@localhost:5433/able

# Auth (Better Auth). Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth — redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend). Without a key, OTP codes are printed to the server console in development.
RESEND_API_KEY=
EMAIL_FROM="ABLE <no-reply@able.example>"

# Storage + Realtime (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice and video calls (Daily.co)
DAILY_API_KEY=

# AI — Anthropic Claude (structuring, bio writing, match reasons, translation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AI — OpenAI (speech-to-text + embeddings)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Section 33/34 (Thailand). Levy per missing hire in THB — verify the current
# amount with the Department of Empowerment of Persons with Disabilities.
# Leave empty to hide the amount.
QUOTA_LEVY_PER_PERSON_THB=

# Judge mode / cron
CRON_SECRET=
# Comma-separated emails that get the ADMIN role on sign-in
ADMIN_EMAILS=

# Monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Show the "some services aren't configured" notice to visitors (setup only). Leave unset in production.
# SHOW_KEY_NOTICE=1
